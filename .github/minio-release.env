# The MinIO server CI runs its tests against, pinned by release and verified
# against a digest that lives here rather than being fetched beside the binary
# -- a checksum from the same origin as the download cannot attest to it.
#
# To bump: change MINIO_RELEASE, then replace each digest from
#   https://dl.min.io/aistor/minio/release/<platform>/archive/minio.$MINIO_RELEASE.sha256sum
# The digests changing is the point: they show up in review.
MINIO_RELEASE=RELEASE.2026-09-07T08-39-31Z
MINIO_SHA256_LINUX_AMD64=f62b67211cb8c19bb37aa5f318b8842987b261b7f0e985df61a5fe30707e7827
MINIO_SHA256_LINUX_ARM64=8667dbae348167a71dd686177845c09bd033b4fbed155fa2bb5b2ad4f67e5644
MINIO_SHA256_DARWIN_ARM64=5c7edd0bab341a94b18da4b24e76c1b5a9272f67d015a643d48fd0e3618c54a0
MINIO_SHA256_WINDOWS_AMD64=393be601638a2ec57bc334400baadce8c27fdcb1e8c4f35e7c21a1fd121167fb
